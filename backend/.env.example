# Backend environment configuration
# Copy this file to .env and adjust values as needed

# Elexon BMRS API configuration
ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_API_TIMEOUT=30

# Application configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=false

# CORS configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,https://qwerty-coral-five.vercel.app
# Regex for dynamic origins such as Vercel preview deployments
CORS_ORIGIN_REGEX=https://qwerty-.*-titanskings-projects\.vercel\.app

# Data cache configuration (in seconds)
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true

# Analysis configuration
ANALYSIS_YEAR=2026
ANALYSIS_MONTH=1
WIND_FUEL_TYPE=WIND

# Logging
LOG_LEVEL=INFO